# Northern's TURN settings for InPerson (src/h2t/TurnApi.js) - pick one block.
# Export them before `npm start`; Northern reads them on every /turn/api/ice.
# Keep the real file out of git: it holds secrets.

# coturn, with the TURN REST secret (example/coturn/turnserver.conf)
NORTHERN_TURN=coturn
NORTHERN_TURN_SECRET=CHANGE-ME-openssl-rand-hex-32
NORTHERN_TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp,turns:turn.example.org:5349?transport=tcp
NORTHERN_TURN_STUN=stun:turn.example.org:3478

# coturn on Amazon Lightsail (example/lightsail/setup.sh): TLS on 443
# NORTHERN_TURN=coturn
# NORTHERN_TURN_SECRET=<the SECRET given to setup.sh>
# NORTHERN_TURN_URLS=turn:turn.example.org:3478?transport=udp,turn:turn.example.org:3478?transport=tcp,turns:turn.example.org:443?transport=tcp
# NORTHERN_TURN_STUN=stun:turn.example.org:3478

# Cloudflare Realtime TURN (example/cloudflare/ice-servers.sh)
# NORTHERN_TURN=cloudflare
# NORTHERN_TURN_KEY_ID=CHANGE-ME
# NORTHERN_TURN_KEY_TOKEN=CHANGE-ME

# How long a credential lasts, in seconds (default 43200, 12 hours).
# NORTHERN_TURN_TTL=43200

# How many times a minute one user may ask for credentials (default 6). A
# call asks once at each end; past the limit Northern answers 429, and the
# call tries without TURN.
# NORTHERN_TURN_RATE=6
